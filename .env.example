# Copiá este archivo a .env y ajustá los valores
# No commitear .env al repositorio

# Sobreescribe el path al CLI si es necesario
# PREP_CLI_PATH=C:/Program Files/Tableau/Tableau Prep Builder 2024.1/scripts/tableau-prep-conductor.bat

# Catálogo de datos — conexión MySQL (también usada para el DW)
CATALOG_MYSQL_HOST=10.0.10.165
CATALOG_MYSQL_PORT=3306
CATALOG_MYSQL_DB=orbith_bi
CATALOG_MYSQL_USER=
CATALOG_MYSQL_PASSWORD=

# DW — usuario de solo lectura para consultar() (si está vacío usa las credenciales del catálogo)
DW_MYSQL_USER=
DW_MYSQL_PASSWORD=

# Límites de consulta
DW_QUERY_TIMEOUT_SEC=30
DW_MAX_ROWS=5000
